    "A little stronger than Version 1. The sliders below still fall well short of the current look.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/CameraRawGeometryCalibration.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas stärker als Version 1. Die Schieberegler unten bleiben immer noch weit hinter dem aktuellen Look zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little stronger than Version 1. The sliders below still fall well short of the current look."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco más intenso que la versión 1. Los reguladores siguientes aún producen un efecto mucho menor que el aspecto actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu plus fort que la version 1. Les curseurs ci-dessous sont encore bien en deçà de l'aspect actuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン 1 よりやや強い効果です。下のスライダーの効果は、現在の処理方式よりもかなり弱くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 1보다 효과가 약간 강합니다. 아래 슬라이더의 효과는 현재 처리 방식보다 여전히 훨씬 약합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco mais intenso que a versão 1. Os controles deslizantes abaixo ainda produzem um efeito muito menor que a aparência atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "效果略强于版本 1。下方滑块的调整幅度仍明显小于当前版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "效果略強於版本 1。下方滑桿的調整幅度仍明顯小於目前版本。"
          }
        }
      }
    },
