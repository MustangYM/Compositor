    "No foreground subject was detected in this layer. Try an image with a more distinct subject.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/SubjectRemoval.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
