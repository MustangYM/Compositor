    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei-Wege zeigt Tiefen, Mitteltöne und Lichter. Die anderen Optionen zeigen jeweils ein Farbrad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres vías muestra sombras, medios tonos e iluminaciones. Las demás opciones muestran una sola rueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois voies affiche les tons foncés, moyens et clairs. Les autres options affichent une seule roue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「3 方向」はシャドウ、中間調、ハイライトを表示します。他の選択肢ではホイールを 1 つ表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3방향은 어두운 영역, 중간 영역, 밝은 영역을 표시합니다. 다른 옵션은 휠 하나를 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três vias mostra sombras, tons médios e realces. As outras opções mostram uma única roda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“三向”同时显示阴影、中间调和高光色轮。其他选项仅显示一个色轮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「三向」同時顯示陰影、中間調和亮部色輪。其他選項僅顯示一個色輪。"
          }
        }
      }
    },
