    "Some dropped items couldn’t be read. Drag JPEG, PNG, HEIC, TIFF, or Photoshop (PSD) files from Finder.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/IO/ImageFileDrop.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige abgelegte Elemente konnten nicht gelesen werden. Ziehen Sie JPEG-, PNG-, HEIC-, TIFF- oder Photoshop-Dateien (PSD) aus dem Finder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some dropped items couldn’t be read. Drag JPEG, PNG, HEIC, TIFF, or Photoshop (PSD) files from Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer algunos elementos soltados. Arrastre archivos JPEG, PNG, HEIC, TIFF o Photoshop (PSD) desde el Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments déposés n’ont pas pu être lus. Faites glisser des fichiers JPEG, PNG, HEIC, TIFF ou Photoshop (PSD) depuis le Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロップした項目の一部を読み込めませんでした。Finder から JPEG、PNG、HEIC、TIFF、または Photoshop（PSD）ファイルをドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "놓은 항목 중 일부를 읽을 수 없습니다. Finder에서 JPEG, PNG, HEIC, TIFF 또는 Photoshop (PSD) 파일을 드래그하세요."
          }
        },
        "pt-BR": {
