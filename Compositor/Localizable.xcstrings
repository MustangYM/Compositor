    "Not enough unselected, opaque image pixels to synthesize a fill. Use a smaller selection with some surrounding image.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/ContentFill.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend nicht ausgewählte, deckende Bildpixel zum Erzeugen einer Füllung. Verwenden Sie eine kleinere Auswahl mit umgebendem Bildinhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough unselected, opaque image pixels to synthesize a fill. Use a smaller selection with some surrounding image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficientes píxeles opacos fuera de la selección para generar el relleno. Use una selección menor con parte de la imagen a su alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de pixels opaques non sélectionnés pour générer un remplissage. Utilisez une sélection plus petite entourée de contenu d’image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "塗りつぶしの合成に必要な、選択範囲外の不透明なピクセルが不足しています。周囲に画像が残るよう、選択範囲を小さくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칠할 내용을 합성하는 데 필요한 선택 영역 바깥의 불투명 픽셀이 부족합니다. 주변 이미지가 남도록 선택 영역을 줄이세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há pixels opacos suficientes fora da seleção para gerar o preenchimento. Use uma seleção menor com parte da imagem ao redor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选区外的不透明像素不足，无法合成填充。请缩小选区并保留一些周围图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取範圍外的不透明像素不足，無法合成填滿。請縮小選取範圍並保留一些周圍影像。"
          }
        }
      }
    },
    "Nothing is selected, so there’s nowhere to paint. Choose Select › Deselect (⌘D) to paint anywhere.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/EditorSession+Brush.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl enthält keine Pixel zum Malen. Wählen Sie Auswahl › Auswahl aufheben (⌘D), um überall malen zu können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is selected, so there’s nowhere to paint. Choose Select › Deselect (⌘D) to paint anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección está vacía y no hay ningún área donde pintar. Elija Selección › Deseleccionar (⌘D) para pintar en cualquier lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection ne contient aucun pixel sur lequel peindre. Choisissez Sélection › Désélectionner (⌘D) pour peindre partout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲が空のため、描画できる場所がありません。「選択範囲」›「選択を解除」（⌘D）を選ぶと、どこにでも描画できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 영역이 비어 있어 칠할 곳이 없습니다. 선택 › 선택 해제(⌘D)를 선택하면 어디에나 칠할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção está vazia e não há uma área para pintar. Escolha Selecionar › Cancelar seleção (⌘D) para pintar em qualquer lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前选区为空，无法绘画。选择“选择 › 取消选择”(⌘D) 后可在任意位置绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前選取範圍為空，無法繪畫。選取「選取 › 取消選取」(⌘D) 後可在任意位置繪畫。"
