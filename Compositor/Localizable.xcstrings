    "HSL lists every color. Color edits one family. Point Color adjusts a color you pick.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL zeigt alle Farben. Farbe bearbeitet eine Farbfamilie. Punktfarbe passt eine aufgenommene Farbe an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL lists every color. Color edits one family. Point Color adjusts a color you pick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL muestra todos los colores. Color edita una familia. Color de punto ajusta un color que elija."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TSL affiche toutes les couleurs. Couleur modifie une famille de couleurs. Couleur du point ajuste une couleur prélevée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「HSL」はすべての色を表示し、「カラー」は 1 つの色系統を編集します。「ポイントカラー」は指定した色を調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL은 모든 색상을 나열합니다. 색상은 한 색상 계열을 편집합니다. 포인트 색상은 지정한 색상을 조정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL mostra todas as cores. Cor edita uma família. Cor pontual ajusta uma cor escolhida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“HSL”列出所有色系；“颜色”编辑单个色系；“点颜色”调整拾取的特定颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「HSL」列出所有色系；「顏色」編輯單個色系；「點顏色」調整拾取的特定顏色。"
          }
        }
      }
    },
