    "Basic is quick; Advanced refines the mask against the layer's own detail, for hair and fur": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Grundeinstellungen“ arbeitet schnell; „Erweitert“ verfeinert die Maske anhand der Ebenendetails, etwa für Haare und Fell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic is quick; Advanced refines the mask against the layer's own detail, for hair and fur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Básico es rápido; Avanzado perfecciona la máscara según los detalles de la propia capa, como el cabello y el pelo de animales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages de base est rapide ; Avancé affine le masque selon les détails du calque, notamment les cheveux et les poils"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「基本」は高速に処理します。「詳細」は髪や毛並みなど、レイヤー自体の細部に合わせてマスクを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본은 빠르게 처리합니다. 고급은 머리카락이나 털처럼 레이어 자체의 세부 묘사에 맞춰 마스크를 다듬습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Básico é rápido; Avançado refina a máscara com base nos detalhes da própria camada, como cabelos e pelos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“基本”处理速度快；“高级”根据图层细节优化蒙版，适合头发和毛发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「基本」處理速度快；「進階」根據圖層細節最佳化遮色片，適合頭髮和毛髮"
          }
        }
      }
    },
