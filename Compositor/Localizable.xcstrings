    "Darkens or lightens the edges. The center does not change.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt die Ränder ab oder hellt sie auf. Die Mitte bleibt unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Darkens or lightens the edges. The center does not change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece o aclara los bordes. El centro no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit ou éclaircit les bords. Le centre reste inchangé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周辺を暗くしたり明るくしたりします。中央は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리를 어둡게 또는 밝게 합니다. 중심은 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece ou clareia as bordas. O centro não muda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗或提亮边缘，中心保持不变。"
