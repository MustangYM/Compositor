            "value": "Die Füllmethode „%1$@“ wird nicht unterstützt. Es wird „Normal“ verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blend mode “%1$@” isn’t supported and will be applied as Normal."
          }
        },
