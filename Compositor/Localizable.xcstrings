    "Perspective allows stronger keystone. Rectilinear keeps the warp gentler.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawGeometryCalibrationControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perspektivisch erlaubt stärkere Trapezkorrekturen. Geradlinig hält die Verformung sanfter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perspective allows stronger keystone. Rectilinear keeps the warp gentler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perspectiva permite una corrección trapezoidal más intensa. Rectilínea mantiene una deformación más suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perspective permet une correction trapézoïdale plus forte. Rectiligne garde une déformation plus douce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「遠近法」は強い台形補正が可能です。「直線」はゆがみを穏やかに抑えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원근은 강한 사다리꼴 교정을 허용합니다. 직선은 변형을 부드럽게 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perspectiva permite uma correção trapezoidal mais intensa. Retilínea mantém uma deformação mais suave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“透视”允许更强的梯形校正；“直线”模式的变形较柔和。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「透視」允許更強的梯形校正；「直線」模式的變形較柔和。"
          }
        }
      }
    },
