        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el cuadro y los tiradores de transformación (⌘H). Si están ocultos, arrastre en cualquier lugar para mover la capa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le cadre et les poignées de transformation (⌘H). S’ils sont masqués, faire glisser n’importe où pour déplacer le calque."
