    "Editable Photoshop text becomes pixels and can’t be retyped.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/IO/PSD/PSDText.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeitbarer Photoshop-Text wird in Pixel umgewandelt und kann nicht mehr als Text bearbeitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editable Photoshop text becomes pixels and can’t be retyped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto editable de Photoshop se convierte en píxeles y ya no se puede editar como texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte Photoshop modifiable est converti en pixels et ne peut plus être modifié en tant que texte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Photoshop の編集可能なテキストはピクセルに変換され、文字を再編集できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Photoshop의 편집 가능한 텍스트는 픽셀로 변환되어 문자를 다시 편집할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto editável do Photoshop é convertido em pixels e não pode mais ser editado como texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Photoshop 的可编辑文字将栅格化为像素，无法继续作为文字编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Photoshop 的可編輯文字將點陣化為像素，無法繼續作為文字編輯。"
          }
        }
      }
    },
