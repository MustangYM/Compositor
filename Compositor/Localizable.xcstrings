    "Smooth selection edges; turn off for hard pixel edges": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/LassoControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahlkanten glätten; für harte Pixelkanten deaktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth selection edges; turn off for hard pixel edges"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suavizar los bordes de selección; desactivar para obtener bordes de píxel duros"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisser les contours de la sélection ; désactiver pour des bords de pixels nets"
