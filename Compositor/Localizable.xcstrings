    "Hue around the wheel, saturation outward from the center. Control-click to show the histogram.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
