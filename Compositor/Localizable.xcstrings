    "Sets how far the glow reaches. Has no effect until Glow is raised.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Reichweite des Scheins fest. Wirkt erst bei erhöhtem Schein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets how far the glow reaches. Has no effect until Glow is raised."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define el alcance del resplandor. No tiene efecto hasta que se aumenta Resplandor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit la portée de la lueur. Sans effet tant que la lueur n’est pas augmentée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光彩の広がる距離を設定します。「光彩」を上げるまで効果は現れません。"
