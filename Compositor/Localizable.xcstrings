    "Layer effects were discarded, so the appearance may differ.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/IO/PSD/PSDDocumentBuilder.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebeneneffekte wurden verworfen; das Aussehen kann daher abweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layer effects were discarded, so the appearance may differ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los efectos de la capa fueron descartados, por lo que la apariencia puede diferir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les effets de calque ont été supprimés ; l’apparence peut donc différer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤー効果は破棄されたため、見た目が異なる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 효과가 제거되어 모양이 다를 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os efeitos da camada foram descartados, de modo que a aparência pode diferir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层样式已被丢弃，外观可能有所不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖層樣式已被丟棄，外觀可能有所不同。"
          }
        }
      }
    },
