    "Line height, baseline to baseline. Empty or 0 is Auto: 120% of the font size.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/TypeControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilenhöhe von Grundlinie zu Grundlinie. Leer oder 0 bedeutet Auto: 120 % der Schriftgröße."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line height, baseline to baseline. Empty or 0 is Auto: 120% of the font size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura de línea, de línea de base a línea de base. Vacío o 0 indica Automático: 120 % del tamaño de fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur de ligne, d’une ligne de base à l’autre. Vide ou 0 signifie Auto : 120 % du corps de la police."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースライン間の行の高さです。空欄または 0 は「自動」で、フォントサイズの 120% になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준선 사이의 행 높이입니다. 비워 두거나 0을 입력하면 자동으로 글꼴 크기의 120%가 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura da linha, de uma linha de base à seguinte. Vazio ou 0 indica Automático: 120% do tamanho da fonte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相邻文字基线之间的距离。留空或设为 0 即为“自动”：字号的 120%。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相鄰文字基線之間的距離。留空或設為 0 即為「自動」：文字大小的 120%。"
          }
        }
      }
    },
