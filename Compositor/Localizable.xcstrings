    },
    "Brightens or darkens the corners to counter lens falloff.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawDetailOpticsControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hellt die Ecken auf oder dunkelt sie ab, um den Lichtabfall des Objektivs auszugleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightens or darkens the corners to counter lens falloff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aclara u oscurece las esquinas para compensar la pérdida de luz del objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclaircit ou assombrit les coins pour compenser le vignettage de l’objectif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の四隅を明るくしたり暗くしたりして、レンズによる周辺光量の低下を補正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모서리를 밝게 또는 어둡게 하여 렌즈의 주변부 광량 저하를 보정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clareia ou escurece os cantos para compensar a queda de luminosidade da lente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗四角，补偿镜头的边缘失光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或壓暗四角，補償鏡頭的邊緣失光。"
          }
        }
      }
    },
    "Brightens or darkens the whole picture, in stops of light. Hold Option to see clipped highlights.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hellt das gesamte Bild in Blendenstufen auf oder dunkelt es ab. Halten Sie die Option-Taste gedrückt, um beschnittene Lichter anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brightens or darkens the whole picture, in stops of light. Hold Option to see clipped highlights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aclara u oscurece toda la imagen en pasos de exposición. Mantenga pulsada Opción para ver las iluminaciones recortadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclaircit ou assombrit toute l’image par valeurs d’exposition. Maintenez la touche Option pour afficher les tons clairs écrêtés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像全体の明るさを露出の段数で調整します。Option キーを押すと白飛びを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노출 스톱 단위로 이미지 전체를 밝게 또는 어둡게 합니다. Option을 누르면 잘린 밝은 영역을 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clareia ou escurece toda a imagem em pontos de exposição. Mantenha Option pressionada para ver os realces cortados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以曝光档数为单位提亮或压暗整幅图像。按住 Option 可查看高光剪切。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以曝光檔數為單位提亮或壓暗整幅影像。按住 Option 可檢視亮部剪裁。"
          }
        }
      }
    },
