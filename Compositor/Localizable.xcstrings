    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt den Schein von kühl zu warm. Halation bleibt rot. Wirkt erst bei erhöhtem Schein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el resplandor de frío a cálido. Halo permanece rojo. No tiene efecto hasta que se aumenta Resplandor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décale la lueur des tons froids aux tons chauds. Le halo rouge reste rouge. Sans effet tant que la lueur n’est pas augmentée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光彩の色を寒色から暖色に変えます。ハレーションは赤のままです。「光彩」を上げるまで効果は現れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광선을 차가운 색에서 따뜻한 색으로 바꿉니다. 할레이션은 빨강을 유지합니다. 광선 값을 높여야 효과가 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera o brilho de frio para quente. Halo permanece vermelho. Não tem efeito até aumentar Brilho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将发光颜色从冷色调整为暖色，光晕仍保持红色。“发光”大于零时才有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將發光顏色從冷色調整為暖色，光暈仍保持紅色。「發光」大於零時才有效。"
          }
        }
      }
    },
    "Shifts the picked color around the color wheel.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
