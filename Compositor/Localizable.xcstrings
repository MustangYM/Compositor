    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteil des Pixelfehlers, der auf Nachbarpixel verteilt wird. Niedrigere Werte erzeugen gleichmäßigere Flächen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of each pixel's error spreads to its neighbors. Less gives flatter areas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto error de cada píxel se distribuye a sus vecinos. Un valor menor produce áreas más uniformes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part de l’erreur de chaque pixel diffusée à ses voisins. Les valeurs basses donnent des aplats plus uniformes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ピクセルの誤差を周囲に拡散する量。少ないほど平坦な領域になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 픽셀의 오차를 주변으로 확산하는 양입니다. 낮을수록 영역이 균일해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto do erro de cada pixel se distribui aos vizinhos. Valores menores produzem áreas mais uniformes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个像素的误差扩散到相邻像素的程度。数值越低，色块越平整"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每個像素的誤差擴散到相鄰像素的程度。數值越低，色塊越平整"
          }
        }
      }
    },
