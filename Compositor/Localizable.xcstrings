            "state": "translated",
            "value": "Difusão"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩散"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擴散"
          }
        }
      }
    },
    "Diffusion is soft and wide, Bloom is tighter, and Halation is a red fringe.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusion wirkt weich und breit, Überstrahlung enger und Halation erzeugt einen roten Farbsaum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusion is soft and wide, Bloom is tighter, and Halation is a red fringe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Difusión es suave y amplia, Resplandor difuso es más concentrado y Halo produce un borde rojo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La diffusion est douce et large, le halo lumineux est plus resserré et le halo rouge crée une frange rouge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「拡散」は柔らかく広がり、「ブルーム」はより狭く、「ハレーション」は赤い縁を生みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확산은 부드럽고 넓게 퍼지고, 블룸은 더 좁게 퍼지며, 할레이션은 붉은 테두리를 만듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Difusão é suave e ampla, Brilho difuso é mais concentrado e Halo produz uma borda vermelha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“扩散”柔和且范围较广，“辉光”更加集中，“光晕”产生红色色边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「擴散」柔和且範圍較廣，「輝光」更加集中，「光暈」產生紅色色邊。"
          }
        }
      }
    },
    "Dims the picture outside this color's range. It is not kept when you press OK.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelt das Bild außerhalb dieses Farbbereichs ab. Diese Vorschau wird beim Bestätigen mit OK nicht übernommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dims the picture outside this color's range. It is not kept when you press OK."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa la imagen fuera del intervalo de este color. El efecto no se conserva al pulsar OK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit l’image en dehors de la plage de cette couleur. Cet aperçu n’est pas conservé lorsque vous appuyez sur OK."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この色の範囲外を暗く表示します。この表示は「OK」を押すと解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색상 범위 바깥을 어둡게 표시합니다. 확인을 누르면 이 표시는 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece a imagem fora do intervalo desta cor. O efeito não é mantido ao pressionar OK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压暗此颜色范围以外的图像区域。点击“确定”后不会保留此预览效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓暗此顏色範圍以外的影像區域。點選「確定」後不會保留此預視效果。"
          }
        }
      }
    },
