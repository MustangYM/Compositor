    "Lock aspect ratio. Hold Shift while dragging a handle to turn it the other way.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/TransformInspector.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitenverhältnis sperren. Beim Ziehen eines Griffs die Umschalttaste gedrückt halten, um die Sperre vorübergehend umzukehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock aspect ratio. Hold Shift while dragging a handle to turn it the other way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear proporciones. Mantenga pulsada Shift al arrastrar un tirador para invertir temporalmente este comportamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller les proportions. Maintenez Maj en faisant glisser une poignée pour inverser temporairement ce réglage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦横比を固定します。ハンドルをドラッグ中に Shift キーを押すと、固定の有効・無効が逆になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종횡비를 잠급니다. 핸들을 드래그하는 동안 Shift를 누르면 잠금 상태가 반대로 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear proporções. Mantenha Shift pressionada ao arrastar uma alça para inverter temporariamente esse comportamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定长宽比。拖动控点时按住 Shift 可临时切换此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定長寬比。拖曳控點時按住 Shift 可臨時切換此設定。"
          }
        }
      }
    },
