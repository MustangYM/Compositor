    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützt helle Pixel beim Anwenden einer dunklen Vignette. Wird von Lichterpriorität verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege los píxeles claros al aplicar una viñeta oscura. Se usa con Prioridad de iluminaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protège les pixels clairs lors de l’application d’une vignette sombre. Utilisé par Priorité des hautes lumières."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周辺を暗くする際に、明るいピクセルを保護します。「ハイライト優先」で使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 비네팅을 적용할 때 밝은 픽셀을 보호합니다. 밝은 영역 우선에서 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege os pixels claros ao aplicar uma vinheta escura. Usado por Prioridade de realces."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用暗色晕影时保护高光像素，仅用于“高光优先”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用暗色暈映時保護亮部像素，僅用於「亮部優先」。"
          }
        }
      }
    },
