    "Make each dithered pixel this many pixels across, for a chunky old-screen look": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite jedes gerasterten Pixels für den groben Look alter Bildschirme"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make each dithered pixel this many pixels across, for a chunky old-screen look"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ampliar cada píxel del tramado a este tamaño para imitar los píxeles grandes de una pantalla antigua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de chaque pixel tramé, pour un aspect à gros pixels d’ancien écran"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディザの各ピクセルを指定した幅に拡大し、昔の画面のように粗く表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 디더 픽셀을 지정한 너비로 확대하여 옛 화면처럼 거칠게 표시"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ampliar cada pixel do pontilhamento para este tamanho, imitando os pixels grandes de uma tela antiga"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置仿色像素的边长，模拟复古屏幕的大颗粒像素"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定混色像素的邊長，模擬復古螢幕的大顆粒像素"
          }
        }
      }
    },
    "Make the lines waver sideways down the screen, like a CRT losing sync": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linien nach unten hin seitlich schwanken lassen, wie bei einem Röhrenbildschirm mit Synchronisationsverlust"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the lines waver sideways down the screen, like a CRT losing sync"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer que las líneas oscilen lateralmente a lo largo de la pantalla, como un monitor CRT que pierde la sincronización"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire onduler les lignes latéralement le long de l’écran, comme un écran cathodique désynchronisé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期が乱れた CRT のように、画面の線を左右に波打たせる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화가 흐트러진 CRT처럼 화면의 선이 좌우로 흔들리게 하기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer as linhas oscilarem lateralmente ao longo da tela, como um monitor CRT perdendo a sincronização"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使扫描线横向摆动，模拟 CRT 失去同步的效果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使掃描線橫向擺動，模擬 CRT 失去同步的效果"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht helle und dunkle Töne mehr oder weniger unterschiedlich, meist in der Mitte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes light and dark tones more or less different, mostly around the middle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o reduce la diferencia entre tonos claros y oscuros, sobre todo en los medios tonos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait des tons clairs et sombres plus ou moins différents, principalement autour du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主に中間調付近で、明暗の差を強めたり弱めたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주로 중간 영역에서 밝고 어두운 색조의 차이를 강화하거나 완화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta ou reduz a diferença entre tons claros e escuros, principalmente nos tons médios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱明暗差异，主要影响中间调附近的区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強或減弱明暗差異，主要影響中間調附近的區域。"
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawDetailOpticsControls.swift",
      "extractionState": "manual",
      "localizations": {
