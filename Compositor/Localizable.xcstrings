    "RGB changes brightness. Red, green, and blue also shift the color.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB verändert die Helligkeit. Rot, Grün und Blau verschieben zusätzlich die Farbe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB changes brightness. Red, green, and blue also shift the color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB cambia el brillo. Rojo, verde y azul también cambian el color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RVB modifie la luminosité. Rouge, Vert et Bleu décalent également la couleur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB は明るさを変えます。レッド、グリーン、ブルーは色も変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB는 밝기를 바꿉니다. 빨강, 녹색, 파랑은 색상도 바꿉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "RGB altera o brilho. Vermelho, verde e azul também alteram a cor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“RGB”调整亮度；红、绿、蓝通道还会改变颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「RGB」調整亮度；紅、綠、藍色版還會改變顏色。"
          }
        }
      }
    },
