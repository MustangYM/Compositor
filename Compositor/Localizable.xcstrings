    "Chooses how bright an area must be to glow. Has no effect until Glow is raised.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wie hell ein Bereich sein muss, um zu leuchten. Wirkt erst bei erhöhtem Schein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chooses how bright an area must be to glow. Has no effect until Glow is raised."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina cuánto brillo necesita una zona para emitir resplandor. No tiene efecto hasta que se aumenta Resplandor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit la luminosité minimale d’une zone pour produire une lueur. Sans effet tant que la lueur n’est pas augmentée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光彩が生じる明るさのしきい値を設定します。「光彩」を上げるまで効果は現れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광선이 생기는 밝기의 임계값을 설정합니다. 광선 값을 높여야 효과가 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina o brilho necessário para uma área emitir um halo. Não tem efeito até aumentar Brilho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置产生辉光的亮度阈值。“发光”大于零时才有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定產生輝光的亮度閾值。「發光」大於零時才有效。"
          }
        }
      }
    },
    "Chooses how strongly the calibration sliders below are applied. Version 6 is the current default.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawGeometryCalibrationControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Stärke der untenstehenden Kalibrierungsregler fest. Version 6 ist der aktuelle Standard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chooses how strongly the calibration sliders below are applied. Version 6 is the current default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina la intensidad de los reguladores de calibración siguientes. La versión 6 es la predeterminada actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit l’intensité d’application des curseurs d’étalonnage ci-dessous. La version 6 est la valeur par défaut actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のキャリブレーションスライダーの適用強度を選択します。現在の初期設定はバージョン 6 です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 보정 슬라이더의 적용 강도를 선택합니다. 현재 기본값은 버전 6입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Determina a intensidade dos controles deslizantes de calibração abaixo. A versão 6 é o padrão atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定下方校准滑块的调整强度。当前默认使用版本 6。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定下方校正滑桿的調整強度。目前預設使用版本 6。"
          }
        }
      }
    },
