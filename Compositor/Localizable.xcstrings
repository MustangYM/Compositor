    "Weakens green fringes inside the green hue range.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawDetailOpticsControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verringert grüne Farbsäume innerhalb des grünen Farbtonbereichs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weakens green fringes inside the green hue range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce los halos verdes dentro del intervalo de tonos verdes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atténue les franges vertes dans la plage de teintes vertes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリーンの色相範囲内のグリーンのフリンジを抑えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹색 색조 범위 안의 녹색 색수차를 줄입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz as bordas verdes dentro do intervalo de matizes verdes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减弱绿色色相范围内的绿色色边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減弱綠色色相範圍內的綠色色邊。"
          }
        }
      }
    },
