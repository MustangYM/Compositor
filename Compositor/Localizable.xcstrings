    "Off leaves the picture as it is. Guided straightens from lines you draw on the picture.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawGeometryCalibrationControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aus“ lässt das Bild unverändert. „Geführt“ richtet es anhand der von Ihnen eingezeichneten Linien aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off leaves the picture as it is. Guided straightens from lines you draw on the picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado conserva la imagen tal como está. Guiado la endereza a partir de las líneas que dibuje sobre ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé laisse l’image inchangée. Guidée la redresse selon les lignes que vous tracez sur l’image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「オフ」は画像を変更しません。「ガイド付き」は画像に描いた線を基準に傾きを補正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄기는 이미지를 그대로 둡니다. 안내선은 이미지에 그린 선을 기준으로 기울기를 교정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado mantém a imagem como está. Guiado a endireita a partir das linhas desenhadas sobre ela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“关闭”保持图像不变；“引导式”根据绘制的引导线校正图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「關閉」保持影像不變；「引導式」根據繪製的引導線校正影像。"
          }
        }
      }
    },
