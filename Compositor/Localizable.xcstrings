    "Adds film grain, strongest in the middle tones.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Filmkorn hinzu, am stärksten in den Mitteltönen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds film grain, strongest in the middle tones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade grano de película, más intenso en los medios tonos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute du grain argentique, plus prononcé dans les tons moyens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルム粒子を追加します。中間調で最も強く現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필름 그레인을 추가합니다. 중간 영역에서 가장 강하게 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona granulação de filme, mais intensa nos tons médios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，中间调区域的效果最强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增底片顆粒，中間調區域的效果最強。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawGeometryCalibrationControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Grün oder Magenta zu den dunkelsten Tönen hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds green or magenta to the darkest tones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade verde o magenta a los tonos más oscuros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute du vert ou du magenta aux tons les plus sombres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も暗い色調にグリーンまたはマゼンタを加えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 어두운 색조에 녹색 또는 마젠타를 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona verde ou magenta aos tons mais escuros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为最暗的色调添加绿色或洋红。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為最暗的色調新增綠色或洋紅。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärkt oder vermindert den Kontrast größerer Strukturen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds or softens contrast along broader shapes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o suaviza el contraste a lo largo de formas más amplias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforce ou adoucit le contraste des grandes structures."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな形状のコントラストを強めたり弱めたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넓은 형태의 대비를 강화하거나 완화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ou suaviza o contraste ao longo de formas mais amplas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱较大范围轮廓的对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強或減弱較大範圍輪廓的對比。"
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
