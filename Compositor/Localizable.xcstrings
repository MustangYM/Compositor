    "Another app changed this project. You can revert to the version on disk, losing your unsaved changes, or keep what you have.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/IO/ProjectController+ExternalChanges.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App hat dieses Projekt geändert. Sie können zur Version auf dem Datenträger zurückkehren und Ihre ungespeicherten Änderungen verwerfen oder die aktuelle Version behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app changed this project. You can revert to the version on disk, losing your unsaved changes, or keep what you have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra aplicación cambió este proyecto. Usted puede volver a la versión en disco, perder sus cambios sin guardar, o mantener lo que tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre application a modifié ce projet. Vous pouvez revenir à la version sur disque en perdant vos modifications non enregistrées, ou conserver la version actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリでこのプロジェクトが変更されました。未保存の変更を破棄してディスク上のバージョンに戻すか、現在の内容を保持できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 이 프로젝트를 변경했습니다. 저장하지 않은 변경 사항을 버리고 디스크의 버전으로 되돌리거나 현재 내용을 유지할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro aplicativo mudou este projeto. Você pode reverter para a versão no disco, perdendo suas alterações não salvas, ou manter o que você tem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用更改了此项目。可以恢复为磁盘上的版本（未保存的更改将丢失），也可以保留当前版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他應用程式更改了此專案。可以恢復為磁碟上的版本（未儲存的更改將遺失），也可以保留目前版本。"
          }
        }
      }
    },
