    "Cropped to the canvas so the file fits in memory. Pixels outside the canvas weren't imported.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/IO/PSD/PSDDocumentBuilder.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Arbeitsfläche zugeschnitten, damit die Datei in den Arbeitsspeicher passt. Pixel außerhalb der Arbeitsfläche wurden nicht importiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cropped to the canvas so the file fits in memory. Pixels outside the canvas weren't imported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha recortado al lienzo para que el archivo quepa en memoria. No se han importado los píxeles exteriores al lienzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recadré à la zone de travail pour que le fichier tienne en mémoire. Les pixels en dehors de cette zone n’ont pas été importés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリに収まるようにカンバスに合わせて切り抜きました。カンバス外のピクセルは読み込まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리에 맞도록 캔버스 크기로 잘랐습니다. 캔버스 바깥의 픽셀은 가져오지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo foi cortado nos limites da tela para caber na memória. Os pixels fora da tela não foram importados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为适应可用内存，图像已按画布范围裁切。未导入画布外的像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為適應可用記憶體，影像已按版面範圍裁切。未讀入版面外的像素。"
          }
        }
      }
    },
    "Crops empty edges after the transform and fits the result back into the frame.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawGeometryCalibrationControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt leere Ränder nach der Transformation und passt das Ergebnis wieder in den Rahmen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crops empty edges after the transform and fits the result back into the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorta los bordes vacíos tras la transformación y ajusta el resultado al marco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les bords vides après la transformation et ajuste le résultat au cadre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変形後の余白を切り抜き、結果をフレーム内に収めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변형 후 빈 가장자리를 잘라내고 결과를 프레임에 다시 맞춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorta as bordas vazias após a transformação e ajusta o resultado à moldura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁去变换后的空白边缘，并将结果缩放至画框内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裁去變形後的空白邊緣，並將結果縮放至畫框內。"
          }
        }
      }
    },
    "Current default. The calibration sliders below apply at full strength.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/CameraRawGeometryCalibration.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktueller Standard. Die Kalibrierungsregler unten werden mit voller Stärke angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current default. The calibration sliders below apply at full strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado actual. Los reguladores de calibración siguientes se aplican con toda su intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeur par défaut actuelle. Les curseurs d’étalonnage ci-dessous s’appliquent à pleine intensité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の初期設定です。下のキャリブレーションスライダーの効果が完全に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 기본값입니다. 아래 보정 슬라이더의 효과를 최대 강도로 적용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão atual. Os controles deslizantes de calibração abaixo são aplicados com intensidade total."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前默认版本。下方校准滑块按完整强度应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
