    "Only print dimensions and resolution change. Pixels stay unchanged.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/ImageSizeSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Druckmaße und Auflösung ändern sich. Die Pixel bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only print dimensions and resolution change. Pixels stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambian las dimensiones de impresión y la resolución. Los píxeles no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les dimensions d’impression et la résolution changent. Les pixels restent inchangés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷サイズと解像度のみを変更します。ピクセルは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인쇄 크기와 해상도만 변경됩니다. 픽셀은 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as dimensões de impressão e a resolução mudam. Os pixels não são alterados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅更改打印尺寸和分辨率，像素保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅更改列印尺寸和解析度，像素保持不變。"
          }
        }
      }
    },
