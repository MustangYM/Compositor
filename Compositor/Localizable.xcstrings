          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That text box exceeds the %1$@-pixel or %2$@-megapixel limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuadro de texto supera el límite de %1$@ píxeles o %2$@ megapíxeles."
          }
