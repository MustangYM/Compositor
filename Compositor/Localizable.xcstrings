    "Parametric lifts tonal regions. Point places anchors on the curve.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Parametrisch“ passt Tonwertbereiche an. „Punkt“ setzt Ankerpunkte auf der Kurve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametric lifts tonal regions. Point places anchors on the curve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramétrica ajusta regiones tonales. Punto coloca puntos de anclaje en la curva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramétrique ajuste les plages tonales. Point place des points d’ancrage sur la courbe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「パラメトリック」は色調の領域ごとに調整します。「ポイント」はカーブ上にアンカーポイントを配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매개 변수는 색조 영역별로 조정합니다. 점은 곡선 위에 기준점을 배치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramétrico ajusta regiões tonais. Ponto coloca pontos de ancoragem na curva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“参数”调整色调区域；“点”通过曲线上的控制点进行调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「參數」調整色調區域；「點」透過曲線上的控制點進行調整。"
          }
        }
      }
    },
