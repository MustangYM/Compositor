    "“%1$@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/EditorSession+Brush.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist eine Gruppe ohne eigene Pixel. Malen Sie auf einer enthaltenen Ebene oder auf der Gruppenmaske."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» es un grupo sin píxeles propios. Pinte en una capa del grupo o en su máscara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est un groupe sans pixels propres. Peignez sur un calque du groupe ou sur son masque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」はグループで、独自のピクセルはありません。グループ内のレイヤーかグループマスクに描画してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”은(는) 자체 픽셀이 없는 그룹입니다. 그룹 안의 레이어나 그룹 마스크에 그리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” é um grupo sem pixels próprios. Pinte em uma camada do grupo ou na máscara do grupo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”是组，本身没有像素。请在组内的图层或组蒙版上绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」是群組，本身沒有像素。請在群組內的圖層或群組遮色片上繪製。"
          }
        }
      }
    },
    "“%1$@” is an adjustment layer, with no pixels to paint. Paint on its mask instead.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/EditorSession+Brush.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist eine Einstellungsebene ohne bemalbare Pixel. Malen Sie stattdessen auf ihrer Maske."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is an adjustment layer, with no pixels to paint. Paint on its mask instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» es una capa de ajuste, sin píxeles en los que pintar. Pinte en su máscara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est un calque de réglage sans pixels sur lesquels peindre. Peignez plutôt sur son masque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は調整レイヤーで、描画できるピクセルがありません。代わりにマスクに描画してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”은 페인팅할 픽셀이 없는 조정 레이어입니다. 대신 마스크에 페인팅하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” é uma camada de ajuste, sem pixels para pintar. Pinte na máscara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”是调整图层，没有可绘画的像素。请在其蒙版上绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」是調整圖層，沒有可繪畫的像素。請在其遮色片上繪畫。"
          }
        }
      }
    },
    "“%1$@” is hidden, or inside a hidden folder. Show it to paint on it.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/EditorSession+Brush.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist ausgeblendet oder befindet sich in einer ausgeblendeten Gruppe. Blenden Sie die Ebene zum Malen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is hidden, or inside a hidden folder. Show it to paint on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» está oculto o dentro de un grupo oculto. Muéstrelo para poder pintar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est masqué ou dans un groupe masqué. Affichez-le pour y peindre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は非表示、または非表示のグループ内にあります。表示してから描画してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”이(가) 숨겨져 있거나 숨겨진 그룹 안에 있습니다. 표시한 후 그리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” está oculto ou dentro de um grupo oculto. Exiba-o para pintar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”已隐藏，或位于隐藏的组中。请先显示它，再进行绘画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」已隱藏，或位於隱藏的群組中。請先顯示它再繪製。"
          }
        }
      }
    },
