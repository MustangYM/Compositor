    "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion).": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive Werte begradigen nach außen gewölbte Linien (Tonnenverzeichnung), negative Werte nach innen gewölbte Linien (Kissenverzeichnung)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores positivos enderezan líneas curvadas hacia fuera (barril); los negativos, líneas curvadas hacia dentro (cojín)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs positives redressent les lignes bombées vers l’extérieur (distorsion en barillet) ; les valeurs négatives redressent celles courbées vers l’intérieur (distorsion en coussinet)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値は外側に膨らむ樽型の線を、負の値は内側にへこむ糸巻き型の線を直線に補正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양수는 바깥으로 휘는 배럴 왜곡을, 음수는 안쪽으로 휘는 핀쿠션 왜곡을 곧게 교정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores positivos endireitam linhas curvadas para fora (barril); valores negativos, linhas curvadas para dentro (almofada)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值校正向外弯曲的桶形畸变；负值校正向内弯曲的枕形畸变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值校正向外彎曲的桶形畸變；負值校正向內彎曲的枕形畸變。"
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/LassoControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive Werte ziehen die erfasste Maske nach innen fest; negative Werte dehnen sie nach außen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive values tighten the detected mask inward; negative values expand it outward"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores positivos ajustan la máscara detectada hacia adentro; los valores negativos se expanden hacia fuera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs positives resserrent le masque détecté vers l'intérieur; les valeurs négatives l'étendent vers l'extérieur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値は検出したマスクを内側に縮小し、負の値は外側に拡張します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양수는 감지된 마스크를 안쪽으로 줄이고 음수는 바깥쪽으로 확장합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores positivos apertam a máscara detectada para dentro; valores negativos a expandem para fora"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值向内收缩检测到的蒙版；负值向外扩展蒙版"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正值向內收縮偵測到的遮色片；負值向外延伸遮色片"
          }
        }
      }
    },
    "Preserve Luminosity": {
