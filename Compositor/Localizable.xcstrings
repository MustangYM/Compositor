    "Option-click to set the source · Drag to clone · [ ] size · Shift-[ ] hardness · 1–0 opacity · Space to pan": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/ContentView.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-Klick: Quelle festlegen · Ziehen: kopieren · [ ] Größe · Umschalt-[ ] Härte · 1–0 Deckkraft · Leertaste: Ansicht verschieben"
          }
        },
        "en": {
