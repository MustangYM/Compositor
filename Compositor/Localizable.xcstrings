    "Click to select similar colors · Tab for Object · Shift add · Option subtract · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/ContentView.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken: ähnliche Farben auswählen · Tab: Objektauswahl · Umschalt: hinzufügen · Option: abziehen · Innen ziehen: verschieben · ⌘-Ziehen: Pixel verschieben · Löschen: leeren · ⌘D: Auswahl aufheben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to select similar colors · Tab for Object · Shift add · Option subtract · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic para seleccionar colores similares · Tab para Objeto · Shift añadir · Opción restar · Arrastrar dentro para mover · ⌘-arrastrar mueve píxeles · Suprimir borra · ⌘D deseleccionar"
          }
        },
        "fr": {
