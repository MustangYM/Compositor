    "Text-editing shortcuts need Command, Option, or Control so they do not replace normal typing.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/KeyboardShortcuts.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastaturbefehle zur Textbearbeitung benötigen Command, Option oder Control, damit sie die normale Texteingabe nicht ersetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text-editing shortcuts need Command, Option, or Control so they do not replace normal typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de edición de texto necesitan Comando, Opción o Control para no sustituir la escritura normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis de modification de texte nécessitent Commande, Option ou Contrôle pour ne pas remplacer la saisie normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の文字入力と重ならないように、テキスト編集のショートカットには Command、Option、Control のいずれかが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 문자 입력과 겹치지 않도록 텍스트 편집 단축키에는 Command, Option 또는 Control이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de edição de texto precisam de Command, Option ou Control para não substituir a digitação normal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字编辑快捷键必须包含 Command、Option 或 Control，以免影响正常输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字編輯快速鍵必須包含 Command、Option 或 Control，以免影響正常輸入。"
          }
        }
      }
    },
