    "Strengthens or weakens every color by the same amount.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stärkt oder schwächt jede Farbe um den gleichen Betrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthens or weakens every color by the same amount."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o reduce la intensidad de todos los colores por igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforce ou affaiblit chaque couleur de la même quantité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての色の鮮やかさを同じ量だけ強めたり弱めたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 색상의 선명도를 같은 양만큼 강화하거나 줄입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
