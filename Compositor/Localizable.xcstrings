    "Keep the source moving with the brush between strokes; off starts every stroke at the source point": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/BrushControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle zwischen Pinselstrichen mit dem Pinsel mitführen; deaktiviert beginnt jeder Strich am Quellpunkt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the source moving with the brush between strokes; off starts every stroke at the source point"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el origen en movimiento con el pincel entre trazos; al desactivarlo, cada trazo comienza en el punto de origen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer la source avec le pinceau entre les tracés ; si désactivé, chaque tracé repart du point source"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストローク間でコピー元をブラシに追従させます。オフの場合、各ストロークはコピー元の基準点から始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "획 사이에도 소스가 브러시를 따라 이동합니다. 끄면 각 획이 소스 기준점에서 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter a origem em movimento com o pincel entre pinceladas; quando desativado, cada pincelada começa no ponto de origem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在多次笔触之间保持取样点与画笔同步移动；关闭后每次笔触从原取样点开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在多次筆觸之間保持取樣點與筆刷同步移動；關閉後每次筆觸從原取樣點開始"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawDetailOpticsControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält den lokalen Kontrast nach der Glättung der Luminanz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps local contrast after luminance smoothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el contraste local después de suavizar la luminancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le contraste local après lissage de la luminance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝度ノイズを軽減した後も局所的なコントラストを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광도 노이즈를 줄인 후에도 부분 대비를 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o contraste local após a suavização da luminância."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少明亮度杂色后保留局部对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少明度雜訊後保留局部對比。"
          }
        }
      }
    },
    "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CanvasSizeSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält diesen Punkt fest. Der Bildinhalt wird nicht skaliert; abgeschnittene Inhalte bleiben außerhalb der Arbeitsfläche erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene este punto fijo. El arte no es escalado; el contenido recortado permanece fuera del lienzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient ce point fixe. L’image n’est pas mise à l’échelle ; le contenu rogné reste en dehors de la zone de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この位置を固定します。画像は拡大・縮小されず、切り抜かれた内容はカンバスの外に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위치를 고정합니다. 이미지의 크기는 바뀌지 않으며 잘린 내용은 캔버스 바깥에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém este ponto fixo. Arte não é escalonada; o conteúdo recortado permanece fora da tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定此定位点。图像内容不会缩放，裁去的内容仍保留在画布外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定此定位點。影像內容不會縮放，裁去的內容仍保留在版面外。"
          }
        }
      }
    },
