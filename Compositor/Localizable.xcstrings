    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Farbrad ziehen. Der Winkel bestimmt den Farbton, der Abstand die Sättigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag inside the wheel. Angle sets hue, distance sets saturation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre dentro de la rueda. El ángulo define el tono y la distancia, la saturación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser dans la roue. L’angle définit la teinte et la distance définit la saturation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイール内をドラッグします。角度で色相、中心からの距離で彩度を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휠 안에서 드래그합니다. 각도는 색조를, 중심으로부터의 거리는 채도를 설정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste dentro da roda. O ângulo define o matiz e a distância define a saturação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色轮内拖动。角度决定色相，距中心的距离决定饱和度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在色輪內拖曳。角度決定色相，距中心的距離決定飽和度。"
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawGeometryCalibrationControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Ebene ziehen, um eine Hilfslinie zu platzieren. Zeichnen Sie mindestens zwei Linien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag on the layer to place a guide. Draw at least two lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre sobre la capa para colocar una guía. Dibuje al menos dos líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur le calque pour placer un repère. Tracez au moins deux lignes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤー上をドラッグしてガイドを配置します。2 本以上の線を描いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 위에서 드래그하여 안내선을 배치합니다. 선을 두 개 이상 그리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste sobre a camada para colocar uma guia. Desenhe pelo menos duas linhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图层上拖动放置引导线。请至少绘制两条线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在圖層上拖曳放置引導線。請至少繪製兩條線。"
          }
        }
      }
    },
    "Drag on the picture to move the curve for the tone under the pointer.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie auf das Bild, um die Kurve für den Ton unter dem Zeiger zu verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag on the picture to move the curve for the tone under the pointer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre en la imagen para mover la curva para el tono bajo el puntero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur l'image pour déplacer la courbe pour le ton sous le pointeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像上をドラッグして、ポインターの下にある色調のカーブを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 위에서 드래그하여 포인터 아래 색조의 곡선을 조정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a imagem para mover a curva para o tom sob o ponteiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图像上拖动，调整指针下方色调对应的曲线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在影像上拖曳，調整指標下方色調對應的曲線。"
          }
        }
      }
