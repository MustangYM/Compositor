    "Break the lines into glowing beads": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linien in leuchtende Perlen aufteilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break the lines into glowing beads"
