        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina neblina al aumentar el valor y la añade al reducirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs élevées suppriment la brume ; les valeurs basses en ajoutent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を上げるとかすみを除去し、下げるとかすみを加えます。"
