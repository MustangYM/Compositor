    "Auto balances the average color. Custom follows Temperature and Tint.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto“ gleicht die durchschnittliche Farbe aus. „Benutzerdefiniert“ verwendet Temperatur und Farbton."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto balances the average color. Custom follows Temperature and Tint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático equilibra el color medio. Personalizado utiliza Temperatura y Matiz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto équilibre la couleur moyenne. Personnalisé utilise les réglages Température et Teinte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」は平均色のバランスを調整します。「カスタム」は色温度と色かぶり補正の値に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 평균 색상의 균형을 맞춥니다. 사용자 정의는 색온도와 색조 설정을 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático equilibra a cor média. Personalizado usa Temperatura e Colorir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”根据平均颜色校正白平衡；“自定”使用色温和色调设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」根據平均顏色校正白平衡；「自訂」使用色溫和色調設定。"
          }
        }
      }
    },
