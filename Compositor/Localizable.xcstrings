    "Resizes layer pixels and applies existing transforms. Undo restores the originals.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/ImageSizeSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Größe der Ebenenpixel und wendet bestehende Transformationen an. „Rückgängig“ stellt die Originale wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resizes layer pixels and applies existing transforms. Undo restores the originals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el tamaño de los píxeles de las capas y aplica las transformaciones existentes. Deshacer restaura los originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redimensionne les pixels du calque et applique les transformations existantes. Annuler restaure les originaux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーのピクセルサイズを変更し、既存の変形を適用します。取り消すと元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 픽셀의 크기를 조절하고 기존 변형을 적용합니다. 실행 취소하면 원본이 복원됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redimensiona os pixels das camadas e aplica as transformações existentes. Desfazer restaura os originais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新采样图层像素并应用现有变换。撤销可恢复原始内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新取樣圖層像素並套用現有變形。還原可恢復原始內容。"
          }
        }
      }
    },
