        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the mask onto the image's own edges, which recovers hair and fur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar la máscara a los bordes de la imagen para recuperar cabellos y pelos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster le masque aux contours de l’image pour récupérer les cheveux et les poils"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像自体の境界にマスクを合わせて、髪や毛並みを復元"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 자체의 가장자리에 마스크를 맞춰 머리카락이나 털 복원"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar a máscara às bordas da imagem para recuperar cabelos e pelos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使蒙版贴合图像本身的边缘，以恢复头发和毛发细节"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使遮色片貼合影像本身的邊緣，以恢復頭髮和毛髮細節"
          }
        }
      }
    },
    "Pulls red and blue fringes apart toward the center to reduce color edging.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawDetailOpticsControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt rote und blaue Farbsäume zur Mitte hin gegeneinander, um Farbränder zu verringern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulls red and blue fringes apart toward the center to reduce color edging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplaza los halos rojos y azules por separado hacia el centro para reducir los bordes de color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décale les franges rouges et bleues l’une par rapport à l’autre vers le centre pour réduire les contours colorés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レッドとブルーの縁の位置を中心方向にずらして、色ずれを軽減します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빨강과 파랑 테두리의 위치를 중심 방향으로 서로 다르게 조정하여 색수차를 줄입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desloca as bordas vermelhas e azuis separadamente em direção ao centro para reduzir os contornos coloridos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将红色和蓝色色边向中心分别校正，以减少色差。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將紅色和藍色色邊向中心分別校正，以減少色差。"
          }
        }
      }
    },
