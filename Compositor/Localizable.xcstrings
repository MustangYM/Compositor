    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstärkt dezente Farben stärker als bereits kräftige Farben und schützt Hauttöne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthens quiet colors more than colors that are already strong, and protects skin tones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realza más los colores apagados que los ya intensos y protege los tonos de piel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforce les couleurs discrètes davantage que les couleurs déjà vives et protège les tons chair."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに鮮やかな色よりも落ち着いた色を強め、肌の色を保護します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 선명한 색상보다 차분한 색상을 더 강화하고 피부색을 보호합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realça mais as cores suaves do que as já intensas e protege os tons de pele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先增强较暗淡颜色的饱和度，并保护肤色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先增強較暗淡顏色的飽和度，並保護膚色。"
          }
        }
      }
    },
