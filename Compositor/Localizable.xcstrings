    "Drag a color in the picture. Nearby color families move together.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie eine Farbe im Bild. Nahe gelegene Farbfamilien bewegen sich zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a color in the picture. Nearby color families move together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un color de la imagen. Las familias de colores cercanas cambian juntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une couleur dans l'image. Les familles de couleurs proches se déplacent ensemble."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像内の色をドラッグします。近い色系統も連動して変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지의 색상을 드래그합니다. 인접한 색상 계열도 함께 변합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma cor na imagem. As famílias de cores próximas mudam juntas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图像中的某种颜色上拖动。相近色系会一起调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在影像中的某種顏色上拖曳。相近色系會一起調整。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Punkt. Klicken Sie, um einen hinzuzufügen. Doppelklicken Sie auf einen Punkt, um ihn zu entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a point. Click to add one. Double-click a point to remove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un punto. Haga clic para añadirlo y doble clic para eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un point. Cliquez pour en ajouter un. Double-cliquez sur un point pour le supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイントをドラッグして調整します。クリックで追加し、ダブルクリックで削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점을 드래그하여 조정합니다. 클릭하면 추가하고 두 번 클릭하면 제거합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um ponto. Clique para adicionar um ponto e clique duas vezes para removê-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动控制点进行调整，单击添加控制点，双击删除控制点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳控制點進行調整，按一下新增控制點，按兩下刪除控制點。"
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/ContentView.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechteck ziehen · Umschalt: hinzufügen · Option: abziehen · Erneut Umschalt beim Ziehen: Quadrat · Innen ziehen: verschieben · ⌘-Ziehen: Pixel verschieben · Löschen: leeren · ⌘D: Auswahl aufheben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un rectángulo · Shift añadir · Opción restar · Shift otra vez durante el arrastre para un cuadrado · Arrastrar dentro para mover · ⌘-arrastrar mueve píxeles · Suprimir borra · ⌘D deseleccionar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracer un rectangle · Maj : ajouter · Option : soustraire · Maj à nouveau pendant le tracé : carré · Glisser à l’intérieur : déplacer · ⌘-glisser : déplacer les pixels · Suppr : effacer · ⌘D : désélectionner"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして長方形を描画 · Shift 追加 · Option 削除 · ドラッグ中に Shift を押し直すと正方形 · 内側をドラッグして移動 · ⌘-ドラッグでピクセルを移動 · Delete 消去 · ⌘D 選択解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 사각형 그리기 · Shift 추가 · Option 빼기 · 드래그 중 Shift를 다시 누르면 정사각형 · 안쪽을 드래그하여 이동 · ⌘-드래그로 픽셀 이동 · Delete 지우기 · ⌘D 선택 해제"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um retângulo · Shift adicionar · Option subtrair · Shift novamente durante o arrasto para um quadrado · Arraste dentro para mover · ⌘-arrastar move pixels · Delete limpa · ⌘D cancelar seleção"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动绘制矩形 · Shift 添加 · Option 减去 · 拖动中再按 Shift 绘制正方形 · 在选区内拖动以移动 · ⌘-拖动移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳繪製矩形 · Shift 新增 · Option 減去 · 拖曳中再按 Shift 繪製正方形 · 在選取範圍內拖曳以移動 · ⌘-拖曳移動像素 · Delete 清除 · ⌘D 取消選取"
