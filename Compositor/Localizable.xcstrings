    "Put each pixel's brightness back afterwards, so only the color moves": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie die Helligkeit jedes Pixels danach zurück, so dass sich nur die Farbe bewegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put each pixel's brightness back afterwards, so only the color moves"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar después el brillo de cada píxel para que solo cambie el color"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remettre la luminosité de chaque pixel après, donc seulement la couleur bouge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理後に各ピクセルの明るさを戻し、色だけを変更"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처리 후 각 픽셀의 밝기를 복원하여 색상만 변경"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar depois o brilho de cada pixel para que apenas a cor mude"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整后恢复各像素的原始亮度，仅改变颜色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整後恢復各像素的原始亮度，僅改變顏色"
          }
        }
      }
    },
