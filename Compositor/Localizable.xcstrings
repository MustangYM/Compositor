          "stringUnit": {
            "state": "translated",
            "value": "Couleurs plus soutenues qu’avec la version 2. Les décalages des couleurs primaires restent plus doux que dans le processus actuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン 2 より色が強くなります。原色の変化は現在の処理方式より穏やかです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 2보다 색상이 강합니다. 원색의 변화는 현재 처리 방식보다 부드럽습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cores mais intensas que na versão 2. As alterações das cores primárias são mais suaves que no processo atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色调整比版本 2 更强，原色调整仍比当前处理版本柔和。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顏色調整比版本 2 更強，原色調整仍比目前處理版本柔和。"
          }
        }
      }
    },
