    "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/MagicWand.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl ist zu detailliert, um ihren Umriss zu erstellen. Versuchen Sie eine andere Toleranz oder aktivieren Sie „Benachbart“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección tiene demasiados detalles para trazar su contorno. Pruebe otra Tolerancia o active Contiguo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sélection est trop détaillée pour en tracer le contour. Essayez une autre tolérance ou activez Pixels contigus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲が細かすぎて輪郭を描画できません。許容値を変更するか、「隣接」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 영역이 너무 복잡하여 윤곽을 표시할 수 없습니다. 허용치를 변경하거나 인접을 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção tem detalhes demais para traçar seu contorno. Tente outra Tolerância ou ative Adjacente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此选区过于复杂，无法生成轮廓。请调整容差，或启用“连续”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此選取範圍過於複雜，無法生成輪廓。請調整容許度，或啟用「連續」。"
          }
        }
      }
    },
    "That shape is too large. A shape can cover up to %1$@ megapixels.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/ShapeTool.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Form ist zu groß. Eine Form kann bis zu %1$@ Megapixel abdecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That shape is too large. A shape can cover up to %1$@ megapixels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma es demasiado grande. Una forma puede cubrir hasta %1$@ megapíxeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette forme est trop grande. Une forme peut couvrir jusqu'à %1$@ megapixels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェイプが大きすぎます。シェイプの上限は %1$@ メガピクセルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양이 너무 큽니다. 모양은 최대 %1$@메가픽셀까지 가능합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma é grande demais. Uma forma pode cobrir até %1$@ megapixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此形状过大。单个形状最多可覆盖 %1$@ 百万像素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此形狀過大。單個形狀最多可覆蓋 %1$@ 百萬像素。"
          }
        }
      }
    },
    "That text box exceeds the %1$@-pixel or %2$@-megapixel limit.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/TypeTool.swift",
      "extractionState": "manual",
      "localizations": {
