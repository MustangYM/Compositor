    "Zoom in (⌘+), now %1$@. At 100% each pixel of the JPEG is one pixel of the screen, as on the canvas": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/JPEGExportSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrößern (⌘+), aktuell %1$@. Bei 100 % entspricht jedes JPEG-Pixel einem Bildschirmpixel, wie auf der Arbeitsfläche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom in (⌘+), now %1$@. At 100% each pixel of the JPEG is one pixel of the screen, as on the canvas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercar (⌘+), ahora %1$@. Al 100 %, cada píxel del JPEG corresponde a un píxel de la pantalla, igual que en el lienzo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom avant (⌘+), actuellement %1$@. À 100 %, chaque pixel du JPEG correspond à un pixel de l’écran, comme sur la zone de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームイン（⌘+）、現在 %1$@。100% ではカンバスと同様に、JPEG の 1 ピクセルが画面の 1 ピクセルに対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확대 (⌘+), 현재 %1$@. 100%에서는 캔버스와 마찬가지로 JPEG의 1픽셀이 화면의 1픽셀에 해당합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais zoom (⌘+), agora %1$@. A 100%, cada pixel do JPEG corresponde a um pixel da tela, como na área de edição"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 (⌘+)，当前为 %1$@。与画布一样，在 100% 时 JPEG 的每个像素对应屏幕的一个像素"
          }
        },
        "zh-Hant": {
