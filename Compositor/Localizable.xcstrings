        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-클릭으로 소스 설정 · 드래그하여 복제 · [ ] 크기 · Shift-[ ] 경도 · 1–0 불투명도 · Space 화면 이동"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-clique define a origem · Arraste para clonar · [ ] tamanho · Shift-[ ] dureza · 1–0 opacidade · Espaço deslocar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Option-单击设置取样点 · 拖动仿制 · [ ] 调整大小 · Shift-[ ] 调整硬度 · 1–0 设置不透明度 · 空格键平移"
