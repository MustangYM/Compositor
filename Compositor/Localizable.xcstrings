    "Hide the background behind a layer mask, keeping the foreground subjects. The pixels stay, so the background can be painted back at any time.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrund mit einer Ebenenmaske ausblenden und Vordergrundmotive erhalten. Die Pixel bleiben erhalten, sodass der Hintergrund jederzeit wieder eingeblendet werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the background behind a layer mask, keeping the foreground subjects. The pixels stay, so the background can be painted back at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar el fondo con una máscara de capa y conservar los sujetos en primer plano. Los píxeles se mantienen, por lo que puede volver a descubrir el fondo pintando en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer l’arrière-plan avec un masque de fusion en conservant les sujets au premier plan. Les pixels sont préservés ; vous pouvez repeindre le masque pour faire réapparaître l’arrière-plan à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーマスクで背景を隠し、前景の被写体を残します。ピクセルは保持されるため、いつでもマスクに描画して背景を復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어 마스크로 배경을 숨기고 전경 피사체를 유지합니다. 픽셀이 보존되므로 언제든지 마스크에 칠하여 배경을 복원할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar o fundo com uma máscara de camada, preservando os objetos em primeiro plano. Os pixels são mantidos, para que você possa revelar o fundo pintando a qualquer momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用图层蒙版隐藏背景并保留前景主体。原像素会保留，可随时在蒙版上绘画恢复背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用圖層遮色片隱藏背景並保留前景主體。原像素會保留，可隨時在遮色片上繪畫恢復背景。"
          }
        }
      }
    },
