    "The 2012 response. Calibration reaches most of the strength used by Version 6.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/CameraRawGeometryCalibration.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verhalten von 2012. Die Kalibrierung erreicht fast die Stärke von Version 6."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 2012 response. Calibration reaches most of the strength used by Version 6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta de 2012. La calibración alcanza casi toda la intensidad de la versión 6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comportement de 2012. L’étalonnage atteint presque l’intensité de la version 6."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 年の処理方式です。キャリブレーションの強度はバージョン 6 に近くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2012년 처리 방식입니다. 보정 강도는 버전 6에 가깝습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resposta de 2012. A calibração atinge quase toda a intensidade da versão 6."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 版处理方式。校准强度已接近版本 6。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 版處理方式。校正強度已接近版本 6。"
          }
        }
      }
    },
    "The brush trails the pointer on a string this long, so a shaky hand still draws a smooth line": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/BrushControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pinsel folgt dem Zeiger mit diesem Abstand, wie an einer Schnur, sodass auch eine unruhige Hand glatte Linien zeichnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The brush trails the pointer on a string this long, so a shaky hand still draws a smooth line"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pincel sigue al puntero a esta distancia, como si estuviera unido por un hilo, para suavizar las líneas incluso si le tiembla la mano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pinceau suit le pointeur à cette distance, comme au bout d’un fil, pour tracer une ligne lisse même avec une main tremblante"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラシは指定した長さのひもで引かれるようにポインターを追従し、手ぶれがあっても滑らかな線を描けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브러시가 지정한 길이의 줄에 연결된 것처럼 포인터를 따라가므로 손이 떨려도 매끄러운 선을 그릴 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pincel segue o ponteiro a esta distância, como se estivesse preso por um fio, para suavizar as linhas mesmo se a mão tremer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置画笔与指针之间的牵引距离，即使手部抖动也能画出平滑线条"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定筆刷與指標之間的牽引距離，即使手部抖動也能畫出平滑線條"
          }
        }
      }
    },
    "The canvas could not be rendered. Try a smaller canvas.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/IO/ImageExporter.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arbeitsfläche konnte nicht gerendert werden. Versuchen Sie eine kleinere Arbeitsfläche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas could not be rendered. Try a smaller canvas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo renderizar el lienzo. Pruebe un lienzo más pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de calculer le rendu de la zone de travail. Essayez une zone de travail plus petite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンバスをレンダリングできませんでした。サイズを小さくしてお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 렌더링할 수 없습니다. 더 작은 캔버스를 사용해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível renderizar a tela. Tente uma tela menor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法渲染画布。请尝试较小的画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法渲染版面。請嘗試較小的版面。"
          }
        }
      }
    },
    "The characters to draw with, in any order: each spot gets the one whose ink best matches its tone": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichen zum Zeichnen, in beliebiger Reihenfolge: Jeder Bereich erhält das Zeichen, dessen Farbdeckung am besten zu seinem Tonwert passt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The characters to draw with, in any order: each spot gets the one whose ink best matches its tone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caracteres con los que dibujar, en cualquier orden: cada punto usa el carácter cuya tinta se ajusta mejor a su tono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caractères utilisés pour dessiner, dans n’importe quel ordre : chaque zone reçoit celui dont l’encrage correspond le mieux à son ton"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画に使う文字を任意の順序で指定します。各位置には、その階調に最も合う濃さの文字を配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리는 데 사용할 문자를 순서에 상관없이 지정합니다. 각 위치에는 해당 명암에 가장 잘 맞는 먹색 농도의 문자를 배치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caracteres com os quais desenhar, em qualquer ordem: cada ponto usa o caractere cuja tinta melhor corresponde ao seu tom"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于绘制的字符，顺序不限：各位置将选用墨量最接近该处色调的字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於繪製的字元，順序不限：各位置將選用墨量最接近該處色調的字元"
          }
        }
      }
    },
    "The copied layers exceed this project’s %1$@-megapixel limit.": {
