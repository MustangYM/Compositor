    "Read colors from the active layer only, or from every visible layer as shown": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/LassoControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farben nur von der aktiven Ebene oder von allen sichtbaren Ebenen wie dargestellt aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read colors from the active layer only, or from every visible layer as shown"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar los colores solo de la capa activa o de todas las capas visibles tal como se muestran"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prélever les couleurs du calque actif uniquement ou de tous les calques visibles tels qu’ils sont affichés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなレイヤーのみ、または表示中のすべてのレイヤーから見た目どおりに色を取得"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 레이어만 또는 표시된 모든 레이어에서 보이는 상태로 색상 추출"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obter as cores apenas da camada ativa ou de todas as camadas visíveis como são exibidas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从当前图层读取颜色，或读取所有可见图层的合成颜色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅從目前圖層讀取顏色，或讀取所有可見圖層的合成顏色"
          }
        }
      }
    },
