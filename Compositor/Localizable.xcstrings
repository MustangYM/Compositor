    "Earliest response. Hue, saturation, and shadow tint move about half as far as Version 6.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/Document/CameraRawGeometryCalibration.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühestes Verhalten. Farbton, Sättigung und Tiefenfarbton ändern sich etwa halb so stark wie in Version 6."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earliest response. Hue, saturation, and shadow tint move about half as far as Version 6."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta más antigua. Los cambios de tono, saturación y matiz de sombras tienen aproximadamente la mitad de la intensidad de la versión 6."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comportement initial. La teinte, la saturation et la teinte des tons foncés varient environ deux fois moins qu’avec la version 6."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も初期の処理方式です。色相、彩度、シャドウの色かぶりの変化量は、バージョン 6 の約半分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 초기의 처리 방식입니다. 색조, 채도 및 어두운 영역 색조의 변화량은 버전 6의 약 절반입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resposta mais antiga. As alterações de matiz, saturação e tonalidade das sombras têm aproximadamente metade da intensidade da versão 6."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最早的处理方式。色相、饱和度和阴影色调的调整幅度约为版本 6 的一半。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最早的處理方式。色相、飽和度和陰影色調的調整幅度約為版本 6 的一半。"
          }
        }
      }
    },
