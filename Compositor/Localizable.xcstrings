    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbton verschiebt die Farbe, Sättigung ihre Intensität und Luminanz ihre Helligkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue shifts the color, Saturation its strength, and Luminance its brightness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tono cambia el color, Saturación su intensidad y Luminancia su brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte modifie la couleur, Saturation son intensité et Luminance sa luminosité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色相は色味、彩度は色の強さ、輝度は明るさを変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색조는 색상을, 채도는 색상의 강도를, 광도는 밝기를 바꿉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Matiz altera a cor, Saturação sua intensidade e Luminância seu brilho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“色相”改变颜色，“饱和度”改变颜色浓度，“明亮度”改变颜色亮度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「色相」改變顏色，「飽和度」改變顏色濃度，「明度」改變顏色亮度。"
          }
        }
      }
    },
