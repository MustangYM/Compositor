    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie nach oben oder unten, um diese Töne anzuheben oder abzusenken. Ziehen Sie einen Trenner entlang der Unterseite, um zu ändern, welche Töne jede Region abdeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre hacia arriba o hacia abajo para levantar o bajar los tonos. Arrastre un divisor a lo largo de la parte inferior para cambiar qué tonos cubre cada región."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser vers le haut ou vers le bas pour soulever ou baisser ces tons. Faites glisser un diviseur le long du bas pour changer les tons que chaque région couvre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にドラッグして、その色調を明るくしたり暗くしたりします。下部の区切りをドラッグすると、各領域が対象とする色調範囲を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 드래그하여 해당 색조를 밝게 또는 어둡게 합니다. 아래쪽 구분선을 드래그하면 각 영역에 포함되는 색조 범위를 바꿀 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para cima ou para baixo para levantar ou baixar esses tons. Arraste um divisor ao longo do fundo para alterar os tons que cada região cobre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖动可提亮或压暗相应色调。拖动底部的分隔点可调整各区域覆盖的色调范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下拖曳可提亮或壓暗相應色調。拖曳底部的分隔點可調整各區域覆蓋的色調範圍。"
          }
        }
      }
    },
    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/FilterSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Pixel als gefüllte Quadrate oder runde Punkte wie auf einem Punktmatrixbildschirm darstellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibujar cada píxel ampliado como un cuadrado sólido o como un punto redondo, como en una pantalla matricial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiner chaque gros pixel sous forme de carré plein ou de point rond, comme sur un écran matriciel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きなピクセルを塗りつぶした正方形、またはドットマトリクス画面のような丸い点として描画"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 큰 픽셀을 단색 사각형이나 도트 매트릭스 화면 같은 둥근 점으로 그리기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhar cada pixel ampliado como um quadrado sólido ou como um ponto redondo, como em uma tela de matriz de pontos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个大像素绘制为实心方块，或类似点阵屏幕的圆点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將每個大像素繪製為實心方塊，或類似點陣螢幕的圓點"
          }
        }
      }
    },
