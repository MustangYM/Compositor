    "No lens metadata on this layer. Profile sliders set generic correction strength.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawDetailOpticsControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Objektivmetadaten auf dieser Ebene. Die Profilregler bestimmen die allgemeine Korrekturstärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No lens metadata on this layer. Profile sliders set generic correction strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta capa no contiene metadatos de lente. Los reguladores de perfil definen la intensidad de una corrección genérica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune métadonnée d’objectif sur ce calque. Les curseurs du profil définissent l’intensité d’une correction générique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイヤーにはレンズのメタデータがありません。プロファイルスライダーで汎用的な補正の強度を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레이어에는 렌즈 메타데이터가 없습니다. 프로필 슬라이더는 일반 교정 강도를 설정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta camada não contém metadados da lente. Os controles deslizantes de perfil definem a intensidade de uma correção genérica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
