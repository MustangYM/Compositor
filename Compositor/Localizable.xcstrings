        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisser : sélectionner · Glisser à l’intérieur : déplacer · Maj : ajouter · Option : soustraire · Suppr : effacer · ⌥⌫/⌘⌫ : remplir · ⌘D : désélectionner"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして選択 · 内側をドラッグして移動 · Shift 追加 · Option 削除 · Delete 消去 · ⌥⌫/⌘⌫ 塗りつぶし · ⌘D 選択解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 선택 · 안쪽을 드래그하여 이동 · Shift 추가 · Option 빼기 · Delete 지우기 · ⌥⌫/⌘⌫ 칠하기 · ⌘D 선택 해제"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para selecionar · Arraste dentro para mover · Shift adicionar · Option subtrair · Delete limpa · ⌥⌫/⌘⌫ preencher · ⌘D cancelar seleção"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动选择 · 在选区内拖动以移动 · Shift 添加 · Option 减去 · Delete 清除 · ⌥⌫/⌘⌫ 填充 · ⌘D 取消选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳選取 · 在選取範圍內拖曳以移動 · Shift 新增 · Option 減去 · Delete 清除 · ⌥⌫/⌘⌫ 填滿 · ⌘D 取消選取"
          }
        }
      }
    },
    "Drag to set hue and saturation. Double-click to reset this wheel.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie, um Farbton und Sättigung einzustellen. Doppelklicken Sie, um dieses Rad zurückzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to set hue and saturation. Double-click to reset this wheel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre para definir el tono y la saturación. Haga doble clic para restablecer esta rueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour définir la teinte et la saturation. Double-cliquez pour réinitialiser cette roue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして色相と彩度を設定します。ダブルクリックでこのホイールをリセットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 색조와 채도를 설정합니다. 두 번 클릭하면 이 휠을 초기화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para definir matiz e saturação. Clique duas vezes para redefinir esta roda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动设置色相和饱和度。双击重置此色轮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
