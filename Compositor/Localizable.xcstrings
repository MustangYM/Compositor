          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックして近似色を選択 · Tab オブジェクト選択に切り替え · Shift 追加 · Option 削除 · 内側をドラッグして移動 · ⌘-ドラッグでピクセルを移動 · Delete 消去 · ⌘D 選択解除"
          }
        },
        "ko": {
          "stringUnit": {
