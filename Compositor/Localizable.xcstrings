    "Linear histogram with automatic vertical scaling. Tall spikes may extend beyond the graph; all tones from 0 to 255 remain included.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/LevelsSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineares Histogramm mit automatischer vertikaler Skalierung. Hohe Spitzen können über die Grafik hinausragen; alle Tonwerte von 0 bis 255 sind enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linear histogram with automatic vertical scaling. Tall spikes may extend beyond the graph; all tones from 0 to 255 remain included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Histograma lineal con escala vertical automática. Los picos altos pueden superar el gráfico; se incluyen todos los tonos de 0 a 255."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Histogramme linéaire avec échelle verticale automatique. Les pics élevés peuvent dépasser le graphique ; tous les tons de 0 à 255 restent inclus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦軸を自動調整するリニアヒストグラムです。高いピークはグラフの上にはみ出す場合がありますが、0～255 のすべての階調が含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세로축이 자동 조정되는 선형 히스토그램입니다. 높은 봉우리가 그래프를 벗어나더라도 0~255의 모든 색조가 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histograma linear com escala vertical automática. Os picos altos podem ultrapassar o gráfico; todos os tons de 0 a 255 são incluídos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直方图采用线性刻度，纵轴自动缩放。较高的峰值可能超出图表范围，但仍包含 0–255 的全部色调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "色階分佈圖採用線性刻度，縱軸自動縮放。較高的峰值可能超出圖表範圍，但仍包含 0–255 的全部色調。"
          }
        }
      }
    },
