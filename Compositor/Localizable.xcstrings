    "Clears haze when raised, and adds haze when lowered.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhere Werte entfernen Dunst, niedrigere Werte fügen Dunst hinzu."
          }
