    "Preserves colored edges while color noise is reduced.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawDetailOpticsControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konserviert farbige Kanten, während das Farbrauschen reduziert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserves colored edges while color noise is reduced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva los bordes coloreados mientras el ruido de color se reduce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserve les bords colorés tandis que le bruit de couleur est réduit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラーノイズを軽減しながら色の境界を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색상 노이즈를 줄이면서 색상 경계를 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva as bordas coloridas enquanto o ruído de cor é reduzido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少颜色杂色时保留彩色边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少顏色雜訊時保留彩色邊緣。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawDetailOpticsControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konserviert feine Textur, während das Luminanzrauschen reduziert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserves fine texture while luminance noise is reduced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva una textura fina mientras se reduce el ruido de luminancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserve la texture fine tandis que le bruit de luminance est réduit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝度ノイズを軽減しながら細かなテクスチャを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광도 노이즈를 줄이면서 미세한 텍스처를 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva textura fina enquanto o ruído de luminância é reduzido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少明亮度杂色时保留精细纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少明度雜訊時保留精細紋理。"
          }
