    "Show the transform box and handles (⌘H). When hidden, drag anywhere to move the layer.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/TransformInspector.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformationsrahmen und Griffe anzeigen (⌘H). Wenn ausgeblendet, zum Verschieben der Ebene an beliebiger Stelle ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the transform box and handles (⌘H). When hidden, drag anywhere to move the layer."
          }
