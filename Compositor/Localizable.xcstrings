    "Makes the selected color family stronger or quieter.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawColorControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht die ausgewählte Farbfamilie kräftiger oder dezenter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes the selected color family stronger or quieter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta o reduce la intensidad de la familia de colores seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend la famille de couleurs sélectionnée plus vive ou plus discrète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色系統を鮮やかにしたり落ち着かせたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 색상 계열을 선명하게 또는 차분하게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta ou reduz a intensidade da família de cores selecionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱所选色系的饱和度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強或減弱所選色系的飽和度。"
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
