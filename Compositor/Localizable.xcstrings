    "Use 1–%1$@ pixels per side, up to %2$@ megapixels, and 1–9,600 pixels/inch.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/ImageSizeSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie 1–%1$@ Pixel pro Seite, bis zu %2$@ Megapixel und 1–9.600 Pixel/Zoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–%1$@ pixels per side, up to %2$@ megapixels, and 1–9,600 pixels/inch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a %1$@ píxeles por lado, hasta %2$@ megapíxeles y de 1 a 9600 píxeles/pulgada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 1–%1$@ pixels par côté, jusqu'à %2$@ mégapixels et 1–9600 pixels/pouce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各辺 1～%1$@ ピクセル、最大 %2$@ メガピクセル、解像度 1～9,600 ピクセル/インチの範囲で指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 변은 1~%1$@픽셀, 전체는 최대 %2$@메가픽셀, 해상도는 1~9,600픽셀/인치로 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a %1$@ pixels por lado, até %2$@ megapixels e de 1 a 9600 pixels/polegada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边须为 1–%1$@ 像素，总计不超过 %2$@ 百万像素，分辨率为 1–9,600 像素/英寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每邊須為 1–%1$@ 像素，總計不超過 %2$@ 百萬像素，解析度為 1–9,600 像素/英吋。"
          }
        }
      }
    },
    "Use gridlines every %1$@–%2$@ pixels and %3$@–%4$@ subdivisions, no more than the pixels between gridlines.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/GridSettingsSheet.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasterlinien alle %1$@–%2$@ Pixel und %3$@–%4$@ Unterteilungen verwenden. Die Zahl der Unterteilungen darf den Pixelabstand zwischen Rasterlinien nicht überschreiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use gridlines every %1$@–%2$@ pixels and %3$@–%4$@ subdivisions, no more than the pixels between gridlines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use líneas de cuadrícula cada %1$@–%2$@ píxeles y %3$@–%4$@ subdivisiones, sin superar el número de píxeles entre líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacer les lignes de grille de %1$@ à %2$@ pixels et utiliser de %3$@ à %4$@ subdivisions, sans dépasser le nombre de pixels entre les lignes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッド線の間隔は %1$@～%2$@ ピクセル、分割数は %3$@～%4$@ にしてください。分割数はグリッド線間のピクセル数以下にする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격자선 간격은 %1$@~%2$@픽셀, 세분은 %3$@~%4$@으로 설정하세요. 세분 수는 격자선 사이의 픽셀 수를 초과할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use linhas de grade a cada %1$@–%2$@ pixels e %3$@–%4$@ subdivisões, sem exceder o número de pixels entre as linhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格线间隔须为 %1$@–%2$@ 像素，子网格数须为 %3$@–%4$@，且不得超过网格线间的像素数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格點線間隔須為 %1$@–%2$@ 像素，子格點數須為 %3$@–%4$@，且不得超過格點線間的像素數。"
          }
        }
      }
    },
