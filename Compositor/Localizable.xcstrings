            "value": "Farbton entlang des Farbrads, Sättigung von der Mitte nach außen. Control-Klick zeigt das Histogramm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hue around the wheel, saturation outward from the center. Control-click to show the histogram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tono cambia alrededor de la rueda y la saturación aumenta desde el centro hacia fuera. Control-clic para mostrar el histograma."
          }
        },
        "fr": {
          "stringUnit": {
