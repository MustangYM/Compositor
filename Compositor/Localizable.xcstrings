          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opción-clic define el origen · Arrastrar para clonar · [ ] tamaño · Shift-[ ] dureza · 1–0 opacidad · Espacio desplazar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
