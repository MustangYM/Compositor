    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "comment": "UI display text. Keep numbered placeholders and keyboard shortcuts intact. Compositor/UI/CameraRawControls.swift",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichterpriorität schützt helle Kanten. Farbpriorität reduziert zusätzlich die Farbe. Farbüberlagerung deckt die Ränder gleichmäßig ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioridad de iluminaciones protege los bordes claros. Prioridad de color también reduce el color. Superposición de pintura cubre los bordes uniformemente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorité des hautes lumières protège les bords clairs. Priorité de couleur réduit aussi la couleur. Incrustation de peinture couvre les bords uniformément."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ハイライト優先」は明るい境界を保護します。「カラー優先」は色も抑えます。「ペイントオーバーレイ」は周辺を均等に覆います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝은 영역 우선은 밝은 가장자리를 보호합니다. 색상 우선은 색상도 줄입니다. 페인트 오버레이는 가장자리를 균일하게 덮습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioridade de realces protege as bordas claras. Prioridade de cores também reduz a cor. Sobreposição de pintura cobre as bordas uniformemente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“高光优先”保护明亮边缘；“颜色优先”还会降低颜色强度；“绘画叠加”均匀覆盖边缘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「亮部優先」保護明亮邊緣；「顏色優先」還會降低顏色強度；「塗料覆蓋」均勻覆蓋邊緣。"
          }
        }
      }
    },
